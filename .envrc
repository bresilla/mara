export TOP_HEAD="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

# Snapshot the running NVIDIA driver version into an env var. The flake reads
# it via `builtins.getEnv` under `--impure`; passing it as a file would fail,
# because flakes in a git repo only expose tracked files to the evaluator and
# anything under `.direnv/` is gitignored globally.
if [ -r /proc/driver/nvidia/version ]; then
  # Line 1 shape: "NVRM version: ... Module for x86_64  580.126.09  Release Build ..."
  export MARA_NVIDIA_VERSION="$(head -n1 /proc/driver/nvidia/version \
    | sed -nE 's/.*  ([0-9.]+)  Release.*/\1/p')"
fi

# Display/backend detection for GUI `make run` targets. Keep this in the
# direnv environment so the Makefile only consumes already-resolved settings.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# Trust WAYLAND_DISPLAY only when it names a live socket. Over SSH / waypipe /
# nested shells it can leak through while pointing at nothing, which makes
# winit panic with `NoCompositor`. Override with `export WL_SOCKET=wayland-1`.
if [ -z "${WL_SOCKET:-}" ]; then
  if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
    export WL_SOCKET="$WAYLAND_DISPLAY"
  else
    export WL_SOCKET="wayland-0"
  fi
fi

# Prefer native Wayland only when the resolved socket exists; otherwise use
# X11/XWayland. Override with `export BACKEND=x11` or `export BACKEND=wayland`.
if [ -z "${BACKEND:-}" ]; then
  if [ -S "$XDG_RUNTIME_DIR/$WL_SOCKET" ]; then
    export BACKEND="wayland"
  else
    export BACKEND="x11"
  fi
fi

# X11 display and GPU wrapper defaults used by Makefile run targets.
export DISPLAY="${DISPLAY:-:1}"
export RUN_WITH="${RUN_WITH:-nixVulkan}"

if [ "$BACKEND" = "wayland" ]; then
  unset WAYLAND_SOCKET
  export WAYLAND_DISPLAY="$WL_SOCKET"
  unset DISPLAY
else
  unset WAYLAND_DISPLAY
  unset WAYLAND_SOCKET
  export DISPLAY="${DISPLAY:-:1}"
fi

use flake --impure --option warn-dirty false

export PATH="$PATH:$PWD/target/debug:$PWD/target/release"

export_alias _b "cd $TOP_HEAD && make build; cd -"
export_alias _c "cd $TOP_HEAD && make compile; cd -"
export_alias _r "cd $TOP_HEAD && make run; cd -"
export_alias _t "cd $TOP_HEAD && make test; cd -"
